# Dev server port (default: 3000)
# PORT=3000

# Open DevTools in production builds (default: false)
# DEBUG_PROD=true

# Enable offline indicator banner (default: disabled)
# NEXT_PUBLIC_ENABLE_OFFLINE_INDICATOR=true

# Crash report endpoint (default: disabled, logs locally only)
# CRASH_REPORT_URL=https://your-crash-reporting-endpoint.com/api/crashes

# --- CI / Code Signing (set in GitHub Secrets) ---
# CSC_LINK=path/to/certificate.p12
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_ID_PASS=
# APPLE_TEAM_ID=
# GH_TOKEN=
